      this.container.appendChild(toast);
    }
    toast.innerHTML = `
      <span>${message}</span>
      ${retryCallback ? '<button id="map-notice-retry" class="underline text-lime-400 hover:text-lime-300 font-bold ml-1 cursor-pointer">Réessayer</button>' : ''}
    `;
    const retryBtn = toast.querySelector('#map-notice-retry');
    if (retryBtn && retryCallback) {
      retryBtn.addEventListener('click', () => {
        toast.remove();
        retryCallback();
      }, { once: true });
    }
    setTimeout(() => {
      if (toast && toast.parentNode) toast.remove();
    }, 6000);
  }

  /**
   * Bascule de l'affichage des étiquettes en mode Satellite
   */
  toggleSatelliteLabels(forcedValue) {
    const nextState = typeof forcedValue === 'boolean' ? forcedValue : !this.satelliteLabelsVisible;
    this.satelliteLabelsVisible = nextState;
    this._applySatelliteLabelsVisibility();
    this._updateSatelliteLabelsBtn();
  }

  _applySatelliteLabelsVisibility() {
    if (!this.map || this.currentMode !== 'satellite' || this._isDestroyed) return;
    const style = this.map.getStyle();
    if (!style || !style.layers) return;
    const excludedSymbolIds = ['road_oneway', 'road_oneway_opposite', 'highway-shield-non-us', 'highway-shield-us-interstate', 'road_shield_us'];
    style.layers.forEach(l => {
      if (l.type === 'symbol') {
        if (excludedSymbolIds.includes(l.id)) {
          try { this.map.setLayoutProperty(l.id, 'visibility', 'none'); } catch (e) {}
        } else {
          try { this.map.setLayoutProperty(l.id, 'visibility', this.satelliteLabelsVisible ? 'visible' : 'none'); } catch (e) {}
        }
      }
    });
  }

  _updateSatelliteLabelsBtn() {
    const btn = this.container?.querySelector('#map-btn-satellite-labels');
    if (!btn) return;
    if (this.currentMode === 'satellite') {
      btn.classList.remove('hidden');
      btn.classList.add('inline-flex');
      const dot = btn.querySelector('span');
      if (dot) dot.className = `w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full transition-colors ${this.satelliteLabelsVisible ? 'bg-emerald-600' : 'bg-slate-300'}`;
      btn.className = `inline-flex items-center gap-1 sm:gap-1.5 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full bg-white/95 backdrop-blur-md shadow-lg border border-slate-200/80 text-[11px] sm:text-xs font-bold transition-all hover:bg-slate-50 cursor-pointer ${this.satelliteLabelsVisible ? 'text-marine-900' : 'text-slate-400'}`;
    } else {
      btn.classList.remove('inline-flex');
      btn.classList.add('hidden');
    }
  }

  /**
   * Changement de mode avec préservation d'état, clamp du zoom et fondu fluide
   */
  setMode(mode) {
    if (!this.map || this.currentMode === mode || this._isDestroyed) return;
    this.currentMode = mode;

    // Règle 4 : Pas d'extrusions 3D en mode Satellite
    if (mode === 'satellite') {
      this._remove3DExtrusions();
    }

    const targetStyle = this.styles[mode];
    if (targetStyle) {
      // Clamper le zoom si nécessaire
      const currentZoom = this.map.getZoom();
      const maxAllowed = 20;
      if (currentZoom > maxAllowed) {
        this.map.easeTo({ zoom: maxAllowed, duration: 200 });
      }

      // Appliquer le style via diff pour une fluidité maximale
      const isVectorDiff = (mode === 'plan' || mode === 'nuit');
      this.map.setStyle(targetStyle, { diff: isVectorDiff });

      // Ré-attacher le marqueur après rechargement de style si nécessaire
      this.map.once('style.load', () => {
        if (this._isDestroyed) return;
        this._updateAttribution();
        if (this.currentMode === 'satellite') {
          this._applySatelliteLabelsVisibility();
        }
        if (this.is3D) {
          if (this.currentMode !== 'satellite') {
            this._apply3DExtrusions();
          } else {
            this._remove3DExtrusions();
          }
        }
      });
    }

    // Mettre à jour l'apparence des pills et glisser l'indicateur
    const pills = this.container.querySelectorAll('.map-mode-pill');
    pills.forEach(p => {
      if (p.getAttribute('data-mode') === mode) {
        p.className = 'map-mode-pill relative z-10 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-bold transition-all cursor-pointer bg-marine-900 text-white shadow-xs';
        p.style.color = '#ffffff';
      } else {
        p.className = 'map-mode-pill relative z-10 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-bold transition-all cursor-pointer text-slate-600 hover:text-slate-900';
        p.style.color = '#475569';
      }
    });

    this._updateModeIndicator(mode);
    this._updateSatelliteLabelsBtn();
    this._updateAttribution();
  }

  toggle3D() {
    if (!this.map || this._isDestroyed) return;
    this.is3D = !this.is3D;

    const targetPitch = this.is3D ? this.options.pitch3D : 0;
    const targetBearing = this.is3D ? this.options.bearing : 0;

    this.map.easeTo({
      pitch: targetPitch,
      bearing: targetBearing,
      duration: 800,
      essential: true
    });

    // Règle 4 : Pas de bâtiments 3D extrudés en mode Satellite (imagerie inclinée pure)
    if (this.is3D && this.currentMode !== 'satellite') {
      this._apply3DExtrusions();
    } else {
      this._remove3DExtrusions();
    }

    const btn3D = this.container.querySelector('#map-btn-3d');
    if (btn3D) {
      const dot = btn3D.querySelector('span');
      if (dot) {
        dot.className = `w-2 h-2 rounded-full ${this.is3D ? 'bg-emerald-600' : 'bg-slate-300'}`;
      }
    }
  }

  _apply3DExtrusions() {
    if (!this.map || this._isDestroyed) return;
    // Règle 4 : Pas de bâtiments 3D extrudés en mode Satellite
    if (this.currentMode === 'satellite') {
      this._remove3DExtrusions();
      return;
    }
    try {
      if (this.map.getLayer('3d-buildings')) return;

      const buildingSource = this.map.getSource('openmaptiles') ? 'openmaptiles' : null;
      if (!buildingSource) return;

      const extrusionColor = this.currentMode === 'nuit' ? '#1c2b42' : '#cbd5e1';

      this.map.addLayer({
        id: '3d-buildings',
        source: buildingSource,
        'source-layer': 'building',
        type: 'fill-extrusion',
        minzoom: 15,
        paint: {
          'fill-extrusion-color': extrusionColor,
          'fill-extrusion-height': [
            'coalesce',
            ['to-number', ['get', 'render_height'], 0],
            ['to-number', ['get', 'height'], 0],
            12
          ],
          'fill-extrusion-base': [
            'coalesce',
            ['to-number', ['get', 'render_min_height'], 0],
            ['to-number', ['get', 'min_height'], 0],
            0
          ],
          'fill-extrusion-opacity': 0.85
        }
      });
    } catch (e) {
      // Non-bloquant si la source de bâtiments n'est pas vectorielle
    }
  }

  _remove3DExtrusions() {
    if (!this.map || this._isDestroyed) return;
    try {
      if (this.map.getLayer('3d-buildings')) {
        this.map.removeLayer('3d-buildings');
      }
    } catch (e) {}
  }

  _renderOfflineFallback() {
    if (!this.container || this._isDestroyed) return;

    const hq = CONFIG.contact?.headquarters || {};
    const coordsStr = hq.formattedCoords || '4.0300055° N, 9.7370284° E';
    const mapUrl = hq.mapUrl || 'https://www.google.com/maps/place/multibusiness/@4.0299706,9.7367761,52m/data=!3m1!1e3!4m6!3m5!1s0x4ba9e03f6fac8b13:0x36fdaca035b5355b!8m2!3d4.0300055!4d9.7370284!16s%2Fg%2F11tp937fdl';

    this.container.innerHTML = `
      <div class="relative w-full h-full min-h-[420px] rounded-3xl overflow-hidden shadow-xl border border-slate-200 bg-slate-900 text-white flex flex-col items-center justify-center p-8 text-center space-y-4">
        <div class="w-14 h-14 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center text-lime-400 mb-2">
          ${icon('map-pin', { class: 'w-7 h-7' })}
        </div>
        <h3 class="font-serif text-2xl font-bold">Siège Social — MULTI BUSINESS SARL</h3>
        <p class="text-sm text-slate-300 max-w-md">
          Dakar (Douala), près du commissariat du 8ᵉ arrondissement, Immeuble Express Union, 1er niveau.<br/>
          Coordonnées : ${coordsStr}
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <a href="${mapUrl}" target="_blank" rel="noopener noreferrer" class="btn-primary !py-2.5 !px-5 text-xs">
            Ouvrir dans Google Maps
          </a>
          <button id="btn-map-retry" class="btn-outline !py-2.5 !px-5 text-xs text-white border-white/40 hover:bg-white/10">
            Réessayer le chargement
          </button>
        </div>
      </div>
    `;

    const retryBtn = this.container.querySelector('#btn-map-retry');
    if (retryBtn) {
      retryBtn.addEventListener('click', () => {
        this._createMap();
      }, { once: true });
    }
  }

  destroy() {
    this._isDestroyed = true;
    if (this._observer) {
      this._observer.disconnect();
      this._observer = null;
    }
    this._cleanups.forEach(fn => {
      try { fn(); } catch (e) {}
    });
    this._cleanups = [];

    if (this.marker) {
      try { this.marker.remove(); } catch (e) {}
      this.marker = null;
    }
    if (this.popup) {
      try { this.popup.remove(); } catch (e) {}
      this.popup = null;
    }
    if (this.map) {
      try { this.map.remove(); } catch (e) {}
      this.map = null;
    }
  }
}
