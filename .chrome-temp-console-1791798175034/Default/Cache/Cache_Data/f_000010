/**
 * MULTI BUSINESS SARL - Module Cartographique Vectoriel Hyper-Premium
 * Architecture résiliente : MapLibre GL JS + Styles Vectoriels Nactifs + Thème Nuit Temps-Réel
 * Repli automatique sans clé (OpenFreeMap) + Satellite Hybride avec sur-échantillonnage
 * Zéro tuile "Map data not yet available", zéro gel de zoom, gestion WebGL complète.
 */

import { CONFIG } from '../../config.js';
import { icon } from '../../icons.js';

let maplibreLoadedPromise = null;

function loadMapLibreAssets() {
  if (maplibreLoadedPromise) return maplibreLoadedPromise;

  maplibreLoadedPromise = new Promise((resolve, reject) => {
    if (typeof window !== 'undefined' && window.maplibregl) {
      return resolve(window.maplibregl);
    }

    // 1. Injecter le CSS MapLibre
    if (!document.querySelector('link[data-maplibre-css]')) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css';
      link.setAttribute('data-maplibre-css', 'true');
      document.head.appendChild(link);
    }

    // 2. Injecter la librairie MapLibre GL JS
    const script = document.createElement('script');
    script.src = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js';
    script.async = true;
    script.onload = () => {
      if (window.maplibregl) {
        resolve(window.maplibregl);
      } else {
        reject(new Error('MapLibre GL JS non trouvé après chargement'));
      }
    };
    script.onerror = () => reject(new Error('Impossible de charger MapLibre GL JS'));
    document.head.appendChild(script);
  });

  return maplibreLoadedPromise;
}

/**
 * Toast de notification discret pour les actions cartographiques
 */
function showMapToast(message) {
  if (typeof document === 'undefined') return;
  let toast = document.getElementById('mb-map-toast');
  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'mb-map-toast';
    toast.className = 'fixed bottom-6 right-6 z-50 px-4 py-2.5 rounded-xl bg-marine-900 text-white text-xs font-semibold shadow-2xl border border-slate-700/60 transition-all duration-300 pointer-events-none flex items-center gap-2 transform translate-y-0 opacity-0';
    document.body.appendChild(toast);
  }
  toast.innerHTML = `<span class="w-2 h-2 rounded-full bg-lime-400 animate-pulse"></span><span>${message}</span>`;
  toast.style.opacity = '1';
  toast.style.transform = 'translateY(0)';
  setTimeout(() => {
    if (toast) {
      toast.style.opacity = '0';
      toast.style.transform = 'translateY(8px)';
    }
  }, 3200);
}

/**
 * Action : Partager la position officielle de MULTI BUSINESS SARL
 */
export function shareCompanyLocation() {
  const hq = CONFIG.contact?.headquarters || {};
  const mapUrl = hq.mapUrl || 'https://www.google.com/maps/place/multibusiness/@4.0299706,9.7367761,52m/data=!3m1!1e3!4m6!3m5!1s0x4ba9e03f6fac8b13:0x36fdaca035b5355b!8m2!3d4.0300055!4d9.7370284!16s%2Fg%2F11tp937fdl';
  const shareData = {
    title: 'MULTI BUSINESS SARL — Siège Social Douala',
    text: `Retrouvez MULTI BUSINESS SARL à Dakar (Douala), Immeuble Express Union (${hq.formattedCoords || '4.0300055° N, 9.7370284° E'})`,
    url: mapUrl
  };

  if (typeof navigator !== 'undefined' && navigator.share) {
    navigator.share(shareData).catch(() => {});
  } else if (typeof navigator !== 'undefined' && navigator.clipboard) {
    navigator.clipboard.writeText(mapUrl).then(() => {
      showMapToast('Position copiée dans le presse-papier !');
    }).catch(() => {
      window.open(mapUrl, '_blank');
    });
  } else if (typeof window !== 'undefined') {
    window.open(mapUrl, '_blank');
  }
}

/**
 * Action : Itinéraire depuis la géolocalisation de l'utilisateur
 */
export function routeFromUserLocation() {
  const hq = CONFIG.contact?.headquarters || {};
  const lat = hq.coordinates?.lat || 4.0300055;
  const lng = hq.coordinates?.lng || 9.7370284;
  const fallbackUrl = hq.googleDirectionsUrl || `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;

  if (typeof navigator === 'undefined' || !navigator.geolocation) {
    if (typeof window !== 'undefined') window.open(fallbackUrl, '_blank');
    return;
  }

  showMapToast('Recherche de votre position GPS...');
  navigator.geolocation.getCurrentPosition(
    pos => {
      const { latitude, longitude } = pos.coords;
      const url = `https://www.google.com/maps/dir/?api=1&origin=${latitude},${longitude}&destination=${lat},${lng}`;
      window.open(url, '_blank');
    },
    err => {
      console.warn('Géolocalisation indisponible :', err?.message);
      showMapToast('Ouverture de l\'itinéraire direct...');
      window.open(fallbackUrl, '_blank');
    },
    { enableHighAccuracy: true, timeout: 7000 }
  );
}

if (typeof window !== 'undefined') {
  window.mbShareLocation = shareCompanyLocation;
  window.mbRouteFromHere = routeFromUserLocation;
}


/**
 * Assainit les expressions d'un style vectoriel (MapTiler ou OpenFreeMap)
 * Enveloppe les hauteurs d'extrusion 3D et propriétés numériques avec coalesce et to-number
 * Évite définitivement l'erreur MapLibre worker : "Expected value to be of type number, but found null instead."
 */
export function sanitizeVectorStyle(style) {
  if (!style || !Array.isArray(style.layers)) return style;

  style.layers.forEach(layer => {
    // 1. Couches d'extrusion de bâtiments 3D
    if (layer.type === 'fill-extrusion' && layer.paint) {
      if (layer.paint['fill-extrusion-height']) {
        layer.paint['fill-extrusion-height'] = [
          'coalesce',
          ['to-number', ['get', 'render_height'], 0],
          ['to-number', ['get', 'height'], 0],
          12
        ];
      }
      if (layer.paint['fill-extrusion-base']) {
        layer.paint['fill-extrusion-base'] = [
          'coalesce',
          ['to-number', ['get', 'render_min_height'], 0],
          ['to-number', ['get', 'min_height'], 0],
          0
        ];
      }
    }

    // 2. Correction de la syntaxe interpolate linear sur boundary_3
    if (layer.id === 'boundary_3' && layer.paint && Array.isArray(layer.paint['line-width'])) {
      if (layer.paint['line-width'][1] && layer.paint['line-width'][1][0] === 'linear') {
        layer.paint['line-width'][1] = ['linear'];
      }
    }
  });

  return style;
}

/**
 * Générateur du thème Nuit dérivé dynamiquement du style vectoriel de base.
 * Garantit un passage Plan <-> Nuit instantané sans nouvelle requête réseau de tuiles.
 */
export function buildNightStyleFromVector(baseStyle) {
  if (!baseStyle || !baseStyle.layers) return baseStyle;
  const dark = JSON.parse(JSON.stringify(baseStyle));
  if (baseStyle.sprite) dark.sprite = baseStyle.sprite;
  if (baseStyle.glyphs) dark.glyphs = baseStyle.glyphs;

  // Palette Nuit Hyper-Premium (Marine Encre, Émeraude & Menthe Marque)
  const PALETTE = {
    bg: '#0b1324',               // Bleu nuit profond (slate-950)
    water: '#07101e',            // Eau marine sombre
    waterLine: '#0d233a',        // Contour littoral
    park: '#0a231c',             // Espaces verts / parcs sombre
    parkOutline: '#11352b',
    residential: '#0f172a',      // Zones résidentielles (slate-900)
    commercial: '#131d33',       // Zones commerciales
    pitchGrass: '#0d251d',
    hwy: '#334155',              // Voies rapides (slate-700)
    primary: '#243247',          // Voies principales
    secondary: '#1c283c',        // Voies secondaires
    minor: '#152033',            // Rues résidentielles
    casing: '#090e1a',           // Contour route
    rail: '#1e293b',
    building: '#172235',         // Bâtiments
    buildingOutline: '#25344d',
    building3d: '#1c2b42',       // Extrusion 3D
    text: '#f1f5f9',             // Texte clair haute lisibilité (AA > 10:1)
    textHalo: '#070d18',         // Halo sombre profond
    adminBoundary: '#2563eb'     // Frontière administrative discrète
  };

  dark.layers = dark.layers.map(layer => {
    const l = JSON.parse(JSON.stringify(layer));
    const type = l.type;
    const id = l.id || '';
    const sl = l['source-layer'] || '';
    l.paint = l.paint || {};

    if (type === 'background') {
      l.paint['background-color'] = PALETTE.bg;
    } else if (id.includes('natural_earth') || id.includes('ne2')) {
      l.layout = l.layout || {};
      l.layout.visibility = 'none'; // Désactiver le raster basse altitude
    } else if (sl === 'water') {
      if (l.paint['fill-color']) l.paint['fill-color'] = PALETTE.water;
      if (l.paint['fill-outline-color']) l.paint['fill-outline-color'] = PALETTE.waterLine;
    } else if (sl === 'waterway') {
      if (l.paint['line-color']) l.paint['line-color'] = PALETTE.waterLine;
    } else if (sl === 'park' || sl === 'landcover') {
      if (l.paint['fill-color']) l.paint['fill-color'] = PALETTE.park;
      if (l.paint['line-color']) l.paint['line-color'] = PALETTE.parkOutline;
    } else if (sl === 'landuse') {
      if (id.includes('residential')) {
        l.paint['fill-color'] = PALETTE.residential;
      } else if (id.includes('commercial') || id.includes('industrial')) {
        l.paint['fill-color'] = PALETTE.commercial;
      } else if (id.includes('cemetery') || id.includes('pitch') || id.includes('grass')) {
        l.paint['fill-color'] = PALETTE.pitchGrass;
      } else {
        l.paint['fill-color'] = PALETTE.residential;
      }
    } else if (sl === 'transportation') {
      if (type === 'line') {
        if (id.includes('casing') || (id.includes('bridge') && id.includes('casing'))) {
          l.paint['line-color'] = PALETTE.casing;
        } else if (id.includes('motorway') || id.includes('trunk')) {
          l.paint['line-color'] = PALETTE.hwy;
        } else if (id.includes('primary')) {
          l.paint['line-color'] = PALETTE.primary;
        } else if (id.includes('secondary') || id.includes('tertiary')) {
          l.paint['line-color'] = PALETTE.secondary;
        } else if (id.includes('rail')) {
          l.paint['line-color'] = PALETTE.rail;
        } else {
          l.paint['line-color'] = PALETTE.minor;
        }
      } else if (type === 'fill') {
        l.paint['fill-color'] = PALETTE.minor;
      }
    } else if (sl === 'building') {
      if (type === 'fill') {
        l.paint['fill-color'] = PALETTE.building;
        l.paint['fill-outline-color'] = PALETTE.buildingOutline;
      } else if (type === 'fill-extrusion') {
        l.paint['fill-extrusion-color'] = PALETTE.building3d;
      }
    } else if (sl === 'boundary') {
      if (l.paint['line-color']) l.paint['line-color'] = PALETTE.adminBoundary;
      l.paint['line-opacity'] = 0.6;
    } else if (type === 'symbol') {
      l.paint['text-color'] = PALETTE.text;
      l.paint['text-halo-color'] = PALETTE.textHalo;
      l.paint['text-halo-width'] = 2.5;
      l.paint['text-halo-blur'] = 1;
      if (l.paint['icon-opacity']) l.paint['icon-opacity'] = 0.85;
    }
    return l;
  });

  return dark;
}

/**
 * Générateur du style Satellite Hybride Pur & Élégant.
 * Insère le raster satellite avec maxzoom: 19 (zoom natif Douala avec sur-échantillonnage natif).
 * Masque INTÉGRALEMENT les couches vectorielles line, fill, fill-extrusion (routes, cours d'eau, bâtiments).
 * Conserve UNIQUEMENT des étiquettes textuelles discrètes, fines et lisibles (quartiers, rues, repères).
 */
export function buildSatelliteHybridStyle(baseVectorStyle) {
  if (!baseVectorStyle) return null;
  const sat = JSON.parse(JSON.stringify(baseVectorStyle));
  if (baseVectorStyle.sprite) sat.sprite = baseVectorStyle.sprite;
  if (baseVectorStyle.glyphs) sat.glyphs = baseVectorStyle.glyphs;

  // Source satellite Esri avec limitation stricte au zoom natif réel (19) pour activer le sur-échantillonnage natif
  sat.sources['esriSat'] = {
    type: 'raster',
    tiles: [
      'https://services.arcgisonline.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}'
    ],
    tileSize: 256,
    maxzoom: 19,
    attribution: 'Imagerie &copy; <a href="https://www.esri.com/" target="_blank" rel="noopener">Esri, Maxar</a>'
  };

  const newLayers = [];

  // Couche raster satellite en arrière-plan
  newLayers.push({
    id: 'satellite-imagery',
    type: 'raster',
    source: 'esriSat',
    minzoom: 0,
    maxzoom: 22
  });

  // Liste des identifiants d'icônes ou de symboles invasifs non textuels à masquer
  const excludedSymbolIds = [
    'road_oneway',
    'road_oneway_opposite',
    'highway-shield-non-us',
    'highway-shield-us-interstate',
    'road_shield_us'
  ];

  // Parcours de toutes les couches du style vectoriel de base
  for (const layer of sat.layers) {
    const type = layer.type;
    const id = layer.id || '';
    const l = JSON.parse(JSON.stringify(layer));
    l.layout = l.layout || {};
    l.paint = l.paint || {};

    // 1. MASQUAGE STRICT DE TOUTES LES COUCHES NON-TEXTUELLES :
    // Toutes les couches line (routes, voies, cours d'eau, limites), fill (bâtiments, sols, eau),
    // fill-extrusion et background sont désactivées avec visibility: 'none'.
    if (type === 'line' || type === 'fill' || type === 'fill-extrusion' || type === 'background' || id.includes('natural_earth')) {
      l.layout.visibility = 'none';
      newLayers.push(l);
      continue;
    }

    // 2. MASQUAGE DES SYMBOLES NON DÉSIRÉS (icônes flèches sens unique, badges autoroutiers)
    const isIconOnly = !l.layout['text-field'] && !!l.layout['icon-image'];
    if (excludedSymbolIds.includes(id) || isIconOnly) {
      l.layout.visibility = 'none';
      newLayers.push(l);
      continue;
    }

    // 3. ÉTIQUETTES TEXTUELLES CONSERVÉES : BLANC PUR + HALO NOIR FRANC, TAILLE MODESTE
    if (type === 'symbol') {
      l.layout.visibility = 'visible';

      // Noms de rues (suivant les axes routiers)
      if (id.startsWith('highway-name-')) {
        l.layout['text-size'] = 11;
        l.paint['text-color'] = '#ffffff';
        l.paint['text-halo-color'] = '#000000';
        l.paint['text-halo-width'] = 2.0;
        l.paint['text-halo-blur'] = 0.5;
        l.paint['text-opacity'] = 0.85;
        // Se masquent à très fort zoom (> 19.3) pour ne pas encombrer le bâtiment du siège
        l.maxzoom = 19.3;
      }
      // Noms de lieux et quartiers (Dakar, Douala, Akwa, etc.)
      else if (id.startsWith('label_') || id.includes('place')) {
        l.paint['text-color'] = '#ffffff';
        l.paint['text-halo-color'] = '#000000';
        l.paint['text-halo-width'] = 2.5;
        l.paint['text-halo-blur'] = 0.8;
        l.paint['text-opacity'] = 0.92;
        if (l.paint['icon-opacity'] !== undefined) l.paint['icon-opacity'] = 0.5;
      }
      // Points d'intérêt utiles (stations, banques, transports)
      else if (id.startsWith('poi_') || id === 'airport') {
        l.paint['text-color'] = '#f8fafc';
        l.paint['text-halo-color'] = '#000000';
        l.paint['text-halo-width'] = 1.8;
        l.paint['text-halo-blur'] = 0.5;
        l.paint['text-opacity'] = 0.80;
        if (l.paint['icon-opacity'] !== undefined) l.paint['icon-opacity'] = 0.55;
      }
      // Autres étiquettes (ex: cours d'eau)
      else {
        l.paint['text-color'] = '#ffffff';
        l.paint['text-halo-color'] = '#000000';
        l.paint['text-halo-width'] = 2.0;
        l.paint['text-halo-blur'] = 0.5;
        l.paint['text-opacity'] = 0.80;
      }

      newLayers.push(l);
    }
  }

  sat.layers = newLayers;
  return sat;
}

export class PremiumMapController {
  constructor(options = {}) {
    this.container = typeof options.container === 'string'
      ? document.getElementById(options.container)
      : options.container;

    this.options = Object.assign({
      center: CONFIG.map?.center || [9.7370284, 4.0300055],
      zoom: CONFIG.map?.zoom || 17.5,
      pitch: CONFIG.map?.pitch || 0,
      pitch3D: CONFIG.map?.pitch3D || 60,
      bearing: CONFIG.map?.bearing || -17.6,
      flyFromCenter: CONFIG.map?.flyFromCenter || [12.3547, 7.3697],
      flyFromZoom: CONFIG.map?.flyFromZoom || 5.5,
      interactive: true,
      compact: false,
      autoFlyIn: true
    }, options);

    this.map = null;
    this.marker = null;
    this.popup = null;
    this.currentMode = 'plan'; // 'plan' | 'satellite' | 'nuit'
    this.is3D = false;
    this.satelliteLabelsVisible = true; // Étiquettes satellite activées par défaut
    this.activeProvider = 'openfreemap'; // 'maptiler' | 'openfreemap'
    this.styles = {};
    this._observer = null;
    this._cleanups = [];
    this._isDestroyed = false;

    if (this.container) {
      this.container.__mapController = this;
    }
    if (typeof window !== 'undefined') {
      window._activeMapController = this;
    }
  }

  async init() {
    if (!this.container || this._isDestroyed) return;
    this.container.__mapController = this;
    if (typeof window !== 'undefined') {
      window._activeMapController = this;
    }

    // Initialisation immédiate et inconditionnelle : garantit la présence instantanée du sélecteur et des contrôles
    await this._createMap();
  }

  async ensureReady() {
    if (this._observer) {
      this._observer.disconnect();
      this._observer = null;
    }
    if (!this.map) {
      await this._createMap();
    }
    return new Promise((resolve) => {
      if (this.map && this.map.loaded()) {
        resolve(this);
      } else if (this.map) {
        this.map.once('load', () => resolve(this));
        setTimeout(() => resolve(this), 3000);
      } else {
        resolve(this);
      }
    });
  }

  /**
   * Résout les styles de carte (Plan vectoriel, Nuit vectoriel dérivé, Satellite hybride sur-échantillonné)
   */
  async _resolveStyles() {
    const key = (CONFIG.map && CONFIG.map.maptilerKey) ? CONFIG.map.maptilerKey.trim() : '';

    let basePlanStyle = null;

    // 1. Tenter MapTiler si une clé est configurée
    if (key) {
      try {
        const maptilerUrl = `https://api.maptiler.com/maps/streets-v2/style.json?key=${key}`;
        const res = await fetch(maptilerUrl);
        if (res.ok) {
          basePlanStyle = await res.json();
          this.activeProvider = 'maptiler';
        }
      } catch (e) {
        console.warn('[PremiumMap] Clé MapTiler indisponible, repli OpenFreeMap transparent:', e.message);
      }
    }

    // 2. Repli OpenFreeMap vectoriel transparent (gratuit, sans clé)
    if (!basePlanStyle) {
      this.activeProvider = 'openfreemap';
      try {
        // Essayer le service en ligne OpenFreeMap
        const ofmUrl = 'https://tiles.openfreemap.org/styles/liberty';
        const res = await fetch(ofmUrl);
        if (res.ok) {
          basePlanStyle = await res.json();
        }
      } catch (e) {
        // Repli local de sécurité
        try {
          const localRes = await fetch('./assets/data/map-style-liberty.json');
          if (localRes.ok) basePlanStyle = await localRes.json();
        } catch (err) {}
      }
    }

    // Sécurité de dernier recours
    if (!basePlanStyle) {
      basePlanStyle = {
        version: 8,
        sources: {
          osm: {
            type: 'raster',
            tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
            tileSize: 256,
            maxzoom: 19
          }
        },
        layers: [{ id: 'osm', type: 'raster', source: 'osm' }]
      };
    }

    // 3. Assainir le style vectoriel contre les expressions nulles
    basePlanStyle = sanitizeVectorStyle(basePlanStyle);

    // 4. Dériver le style NUIT et le style SATELLITE
    const nightStyle = buildNightStyleFromVector(basePlanStyle);
    const satelliteStyle = buildSatelliteHybridStyle(basePlanStyle);

    this.styles = {
      plan: basePlanStyle,
      nuit: nightStyle,
      satellite: satelliteStyle
    };
  }

  async _createMap() {
    if (this._isDestroyed || !this.container) return;

    try {
      // 1. Construction immédiate du squelette d'interface : le sélecteur et les contrôles s'affichent instantanément
      this._buildUiShell();
      this._bindUiEvents();

      const mapContainer = this.container.querySelector('.maplibre-canvas-target');
      if (!mapContainer) return;

      const maplibregl = await loadMapLibreAssets();
      if (this._isDestroyed) return;

      // Résolution des styles vectoriels
      await this._resolveStyles();
      if (this._isDestroyed) return;

      const initialStyle = this.styles[this.currentMode] || this.styles.plan;

      // Clé MapTiler pour transformRequest
      const key = (CONFIG.map && CONFIG.map.maptilerKey) ? CONFIG.map.maptilerKey.trim() : '';

      this.map = new maplibregl.Map({
        container: mapContainer,
        style: initialStyle,
        center: this.options.autoFlyIn ? this.options.flyFromCenter : this.options.center,
        zoom: this.options.autoFlyIn ? this.options.flyFromZoom : this.options.zoom,
        minZoom: 3,
        maxZoom: 20,
        pitch: this.options.pitch,
        bearing: this.options.bearing,
        attributionControl: false,
        cooperativeGestures: true,
        transformRequest: (url, resourceType) => {
          if (key && url.includes('maptiler.com') && !url.includes('key=')) {
            const sep = url.includes('?') ? '&' : '?';
            return { url: `${url}${sep}key=${key}` };
          }
          return { url };
        }
      });

      // Gestionnaire universel d'images de sprites manquantes (office, atm, gate, etc.)
      this.map.on('styleimagemissing', (e) => {
        const id = e?.id;
        if (id && !this.map.hasImage(id)) {
          // Injection immédiate d'un pixel transparent 1x1 pour neutraliser tout avertissement
          this.map.addImage(id, {
            width: 1,
            height: 1,
            data: new Uint8Array([0, 0, 0, 0])
          });
        }
      });

      // Gestion résiliente des erreurs réseau / tuiles
      let consecutiveErrors = 0;
      this.map.on('error', (e) => {
        const msg = e?.error?.message || '';
        // Filtrer les erreurs non critiques pour éviter les blocages
        if (msg.includes('404') || msg.includes('tile') || msg.includes('AbortError')) {
          return;
        }
        if (msg.includes('403') || msg.includes('429') || msg.includes('Failed to fetch')) {
          consecutiveErrors++;
          if (consecutiveErrors >= 3 && this.currentMode !== 'plan') {
            console.warn('[PremiumMap] Échec répété sur mode alternatif, bascule douce vers Plan.');
            consecutiveErrors = 0;
            this.setMode('plan');
            this._showTransientNotice('Connexion réseau limitée : bascule optimisée en mode Plan.', () => {
              this.setMode(this.currentMode);
            });
          }
          return;
        }
        console.warn('[PremiumMap] Info gestionnaire carte:', msg);
      });

      // Gestionnaire WebGL Context Lost & Restored
      const canvas = this.map.getCanvas();
      if (canvas) {
        canvas.addEventListener('webglcontextlost', (e) => {
          e.preventDefault();
          console.warn('[PremiumMap] Contexte WebGL perdu, sauvegarde de l\'état...');
        });
        canvas.addEventListener('webglcontextrestored', () => {
          console.info('[PremiumMap] Contexte WebGL restauré, actualisation du style.');
          if (this.map && !this._isDestroyed) {
            this.map.setStyle(this.styles[this.currentMode]);
          }
        });
      }

      this.map.on('load', () => {
        if (this._isDestroyed) return;
        this._setupMarkerAndPopup(maplibregl);
        this._updateAttribution();

        if (this.options.autoFlyIn) {
          setTimeout(() => {
            if (this._isDestroyed || !this.map) return;
            this.map.flyTo({
              center: this.options.center,
              zoom: this.options.zoom,
              pitch: this.is3D ? this.options.pitch3D : 0,
              bearing: this.options.bearing,
              speed: 1.1,
              curve: 1.42,
              essential: true
            });
          }, 350);
        }
      });

      // UI et événements déjà initialisés au démarrage de _createMap()
    } catch (err) {
      console.warn('[PremiumMap] Repli cartographique élégant:', err.message);
      this._renderOfflineFallback();
    }
  }

