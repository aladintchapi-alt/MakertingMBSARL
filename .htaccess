<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Si le fichier ou le dossier demandé existe physiquement (assets, css, images, etc.), on le sert
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirection de toutes les routes virtuelles vers le index.html local
  RewriteRule . index.html [L]
</IfModule>
